# A private GPU machine running ComfyUI with a working image-to-video workflow.
GIFTY_API_TOKEN=replace-with-a-long-random-secret
GIFTY_ALLOWED_ORIGINS=https://your-project.pages.dev,http://localhost:5173
GIFTY_COMFY_URL=http://127.0.0.1:8188
GIFTY_WORKFLOW_FILE=workflow_api.json
# Node ids must correspond to exported ComfyUI API workflow.
GIFTY_IMAGE_NODE_ID=10
GIFTY_PROMPT_NODE_ID=6
GIFTY_OUTPUT_NODE_ID=48
GIFTY_MAX_PARALLEL_JOBS=1
GIFTY_MAX_JOBS=20
